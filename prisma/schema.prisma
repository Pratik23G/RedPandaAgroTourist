// Prisma schema — Red Panda Agro Tourist
// NOTE: no live DATABASE_URL yet. Pages currently read from lib/data/packages.ts
// (typed to match these models 1:1). Once a real Postgres URL is set in .env,
// run `npm run db:migrate` then `npm run db:seed`, and swap lib/data/packages.ts
// callers over to lib/data/packages-db.ts (Prisma-backed) — see that file's TODO.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageTier {
  INTERNATIONAL
  REGIONAL
  LOCAL
}

enum Currency {
  USD
  NPR
}

model Package {
  id              String         @id @default(cuid())
  slug            String         @unique
  tier            PackageTier
  name            String
  summary         String
  durationLabel   String
  priceAmount     Decimal?       @db.Decimal(10, 2)
  priceCurrency   Currency
  priceUnit       String // e.g. "per person", "per 6 persons", "per person / day"
  priceConfirmed  Boolean        @default(true) // false = TBC, must not be advertised as final
  guaranteeNoSighting Boolean    @default(false)
  inclusions      String[]
  heroImage       String
  galleryImages   String[]
  itineraryDays   ItineraryDay[]
  featured        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ItineraryDay {
  id          String  @id @default(cuid())
  packageId   String
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  description String

  @@unique([packageId, dayNumber])
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  country    String
  quote      String
  rating     Int      @default(5)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum InquiryStatus {
  NEW // just arrived
  CONTACTED // a real conversation has started (counts as a lead)
  INVOICED
  LOST // went cold / chose someone else
  CLOSED // handled, no further action
}

enum InquirySource {
  FORM // website inquiry form
  WHATSAPP // lead added by admin from a WhatsApp chat
  PHONE
  OTHER
}

enum EventType {
  PAGE_VIEW
  WHATSAPP_CLICK
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER // Nepal bank wire / SWIFT / Wise etc.
  WHATSAPP // arranged & confirmed over WhatsApp (e.g. wallet, cash handover)
  ESEWA
  KHALTI
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING // customer says they paid; owner has not verified it landed
  CONFIRMED // owner verified the money arrived
  REJECTED
}

enum EmailDirection {
  OUTBOUND
  INBOUND // logged manually by admin (e.g. customer's bank-slip email)
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED // no RESEND_API_KEY configured; body kept so admin can send by hand
  LOGGED // inbound, recorded by admin
}

model Inquiry {
  id             String        @id @default(cuid())
  name           String
  contact        String // phone/WhatsApp or email, exactly as entered
  country        String
  packageSlug    String?
  groupSize      Int
  preferredDates String
  message        String?
  status         InquiryStatus @default(NEW)
  source         InquirySource @default(FORM)
  createdAt      DateTime      @default(now())
  invoices       Invoice[]

  @@index([createdAt])

  // Data minimization per brief §6.7: retention window enforced by a scheduled
  // job (not built yet) that deletes rows older than 12 months.
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique // RP-2026-0001
  publicToken   String        @unique @default(cuid()) // unguessable id used in the customer's /pay link
  inquiryId     String?
  inquiry       Inquiry?      @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String?
  customerPhone String?
  description   String
  amount        Decimal       @db.Decimal(10, 2)
  currency      Currency
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  payments      Payment[]
  emails        EmailLog[]
}

model Payment {
  id         String        @id @default(cuid())
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Decimal       @db.Decimal(10, 2)
  currency   Currency
  method     PaymentMethod
  reference  String? // bank txn ref / WhatsApp note / eSewa id
  payerNote  String?
  status     PaymentStatus @default(PENDING)
  receivedAt DateTime      @default(now())
  confirmedAt DateTime?
}

model EmailLog {
  id        String         @id @default(cuid())
  invoiceId String?
  invoice   Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  direction EmailDirection
  toAddress String
  subject   String
  body      String
  status    EmailStatus
  error     String?
  createdAt DateTime       @default(now())
}

// Anonymous, first-party analytics. No IP, no user agent, no PII — visitorId is a random id
// in a first-party cookie. Powers the visitors -> WhatsApp -> inquiry -> lead -> booking funnel.
model TrackingEvent {
  id          String    @id @default(cuid())
  visitorId   String
  type        EventType
  path        String
  packageSlug String?
  label       String? // which button, e.g. "hero", "floating", "package-page"
  origin      String? // nepal | saarc | other (from the visitor-origin cookie)
  createdAt   DateTime  @default(now())

  @@index([type, createdAt])
  @@index([visitorId])
}
